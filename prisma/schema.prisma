generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String?
  phone            String?
  agencyName       String?
  agencyAddress    String?
  logoUrl          String?
  plan             String    @default("free")
  isActive         Boolean   @default(true)
  subscriptionEnds DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  invoices         Invoice[]
  leads            Lead[]
  notes            Note[]
  isVerified       Boolean   @default(false)
  verificationCode Int?
  codeExpiresAt    DateTime?
  dailyCodeCount   Int       @default(0)
  lastCodeSentAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  isDemo              Boolean   @default(false)
  isAssigned          Boolean   @default(false)

  @@map("users")
}

model Lead {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  userId            String
  name              String
  phone             String
  whatsapp          String?
  location          String?
  type              String
  status            String    @default("new")
  propertyType      String?   @map("property_type")
  size              String?
  budget            String?
  demand            String?
  floors            String?
  bedrooms          String?
  bathrooms         String?
  hasBasement       Boolean   @default(false) @map("has_basement")
  isCorner          Boolean   @default(false) @map("is_corner")
  isParkFacing      Boolean   @default(false) @map("is_park_facing")
  isMainRoad        Boolean   @default(false) @map("is_main_road")
  hasServantQuarter Boolean   @default(false) @map("has_servant_quarter")
  notes             String?
  lastContacted     DateTime? @map("last_contacted")
  followUp          DateTime? @map("follow_up")
  invoices          Invoice[]
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs              Note[]

  // --- NEW PERFORMANCE INDEXES ---
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([userId])

  @@map("leads")
}

model Note {
  id      Int      @id @default(autoincrement())
  content String
  type    String
  date    DateTime @default(now())
  leadId  Int
  userId  String
  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("notes")
}

model Invoice {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  dueDate   DateTime?
  amount    Float
  status    String    @default("pending")
  details   Json?
  leadId    Int
  userId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model AllowedUser {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventName String   // e.g., "click_call", "click_whatsapp", "generate_invoice"
  createdAt DateTime @default(now())

  // --- NEW PERFORMANCE INDEX ---
  @@index([eventName])
}